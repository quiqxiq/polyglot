# Polyglot — local development environment
# This file is gitignored. Copy from .env.example and fill in real secrets.

APP_ENV=development
APP_PORT=8080
PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgres://postgres:netops@localhost:5432/netops?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Replace with strong random values.
ENCRYPTION_KEY=polyglot_secret_key_32bytes_long
JWT_SECRET=polyglot_jwt_secret_key_at_least_32bytes_long
JWT_EXPIRY_HOURS=24

SESSION_TIMEOUT_MINUTES=30
SLIDING_WINDOW_SIZE=10
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60
LLM_MAX_OUTPUT_TOKENS=512
ALLOWED_TOPICS=layanan internet,paket,harga,tagihan,gangguan,pemasangan,coverage,area,pembayaran,promo,kontak,alamat
WA_STORE_DIR=./wa_stores
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SEED_ADMIN_PASSWORD=admin12345
SEED_AGENT_PASSWORD=agent123

# AnythingLLM — instance VPS (https://anythingllm.ghaibnet.co.id)
ANYTHINGLLM_BASE_URL=https://anythingllm.ghaibnet.co.id
