# Polyglot — local development environment
# This file is gitignored. Copy from .env.example and fill in real secrets.

APP_ENV=development
PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgres://postgres:netops@localhost:5432/netops?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Replace with strong random values (32 bytes).
ENCRYPTION_KEY=polyglot_secret_key_32bytes_long
JWT_SECRET=polyglot_jwt_secret_key_at_least_32bytes_long
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_TTL_HOURS=168

WA_STORE_DIR=./wa_stores
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SEED_OWNER_PASSWORD=owner12345
SEED_ADMIN_PASSWORD=admin12345
SEED_AGENT_PASSWORD=agent123

MIKROTIK_TEST_HOST=192.168.233.1
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASS=r00t

GENIEACS_TEST_URL=
GENIEACS_TEST_DEVICE_ID=
GENIEACS_TEST_API_KEY=

TESTCONTAINERS_POSTGRES_IMAGE=postgres:16-alpine
