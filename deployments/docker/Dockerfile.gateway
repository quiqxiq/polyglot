# syntax=docker/dockerfile:1
# ─── Multi-Stage Dockerfile for Nginx Gateway & Frontends ───

# 1. Build Main React Web Application
FROM node:22-alpine AS web-builder
WORKDIR /app
RUN npm install -g pnpm
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
ARG VITE_API_URL=https://polyglot.ghaibnet.co.id
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm run build

# 2. Production Nginx Gateway
FROM nginx:alpine AS prod
# Copy built React frontend to app directory
COPY --from=web-builder /app/dist /usr/share/nginx/html/app

# Copy GNet Dial static frontend to dial directory
COPY web_dial /usr/share/nginx/html/dial

# Copy Nginx configuration
COPY deployments/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deployments/nginx/conf.d /etc/nginx/conf.d

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
