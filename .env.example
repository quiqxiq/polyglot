# Polyglot — environment template
#
# Copy to .env and fill in real values. .env is gitignored (*.env in
# .gitignore); this file (.env.example) is the tracked template.
# .env.local is for per-developer overrides on top of .env (also gitignored).
#
# Loaded by the Makefile (include .env) so every `make` target sees these
# as exported env vars. The Go app itself should also load .env at startup
# (internal/config/config.go — joho/godotenv).

# ─── PostgreSQL (app database + migration target) ──────────────────────
# Defaults below match deployments/docker-compose.yml so `make db-up &&
# make migrate-up` works out of the box. Override in .env for production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgres://postgres:netops@localhost:5432/netops?sslmode=disable

# ─── Redis (Session State & Rate Limiter for WA Bot) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security & Authentication (JWT & Credential Vault) ───────────────
# EncryptionKey must be exactly 32 bytes for AES-256-GCM (LLM API keys)
ENCRYPTION_KEY=change-me-to-a-32-byte-key!!!!!!
JWT_SECRET=change-me-jwt-secret-key-32-bytes
JWT_EXPIRY_HOURS=24
POLYGLOT_VAULT_KEY=

# ─── WhatsApp & AI Bot Engine Parameters ──────────────────────────────
SESSION_TIMEOUT_MINUTES=30
SLIDING_WINDOW_SIZE=10
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60
LLM_MAX_OUTPUT_TOKENS=512
ALLOWED_TOPICS=layanan internet,paket,harga,tagihan,gangguan,pemasangan,coverage,area,pembayaran,promo,kontak,alamat
WA_STORE_DIR=./wa_stores
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Integration test: Mikrotik (real CHR/device in GNS3) ──────────────
MIKROTIK_TEST_HOST=192.168.230.3
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASS=r00t

# ─── Integration test: GenieACS NBI ────────────────────────────────────
GENIEACS_TEST_URL=
GENIEACS_TEST_DEVICE_ID=
GENIEACS_TEST_API_KEY=

# ─── Testcontainers ───────────────────────────────────────────────────
TESTCONTAINERS_POSTGRES_IMAGE=postgres:17-alpine

# ─── MCP Server (transport + demo device) ─────────────────────────────
MCP_TRANSPORT=http
MCP_HTTP_ADDR=:8080
POLYGLOT_DEMO_DEVICE_ID=
POLYGLOT_DEMO_DRIVER_TYPE=mikrotik
POLYGLOT_DEMO_HOST=
POLYGLOT_DEMO_PORT=
POLYGLOT_DEMO_USERNAME=
POLYGLOT_DEMO_PASSWORD=
