# Polyglot — environment template
#
# Copy to .env and fill in real values. .env and .env.local are gitignored.
# .env.local is for per-developer overrides and is loaded automatically if present.

# ─── Application ───────────────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ─── PostgreSQL (app database + migration target) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgres://postgres:netops@localhost:5432/netops?sslmode=disable

# ─── Redis (Session State & Rate Limiter for WA Bot) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security & Authentication (JWT & Credential Vault) ───────────────
# ENCRYPTION_KEY must be exactly 32 bytes for AES-256-GCM.
# JWT_SECRET must be at least 32 bytes.
ENCRYPTION_KEY=<CHANGEME-32-BYTE-KEY-HERE>
JWT_SECRET=<CHANGEME-32-BYTE-SECRET-HERE>
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_TTL_HOURS=168

# ─── WhatsApp & Web ───────────────────────────────────────────────────
WA_STORE_DIR=./wa_stores
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Admin-only integrations (empty = fail closed) ────────────────────
# Full read/write MCP token for manual admin clients.
POLYGLOT_MCP_TOKEN=
# Read-only MCP token used by the DeepSeek harness (CS/NetOps).
POLYGLOT_MCP_READ_TOKEN=
# Optional static token for non-browser terminal WebSocket clients.
POLYGLOT_WS_TOKEN=

# ─── DeepSeek harness (admin-only NetOps & WhatsApp assistant) ─────────
# dsh executable name or absolute path. The repo-local build can be used via
# HARNESS_DSH_BIN=/absolute/path/to/deepseek-harness/apps/cli/lib/bin.js
#
# The selected dsh profile must configure an LLM provider. The default
# `headless` profile can use DeepSeek (DEEPSEEK_API_KEY) or a local
# 9router/OpenAI-compatible route. For 9router + Gemini, add the llm-pi-ai
# provider and agent-default-model entries to
# $DSH_HOME/profiles/headless/cordis.patch.yml, then export ROUTER_API_KEY.
# DEEPSEEK_API_KEY is not required when the profile selects 9router.
DEEPSEEK_API_KEY=
ROUTER_API_KEY=
HARNESS_DSH_BIN=dsh
# Read-only customer-service overlay passed as --patch. Use an absolute path
# when the server does not run from the repository root.
HARNESS_CS_PATCH=deepseek-harness/packages/bundle/netops-app/netops-cs.patch.yml
# Working directory for the dsh process. Empty = DSH_HOME (~/.dsh by default);
# DSH_HOME is pinned for the child so dsh does not load the Polyglot .env.
HARNESS_WORK_DIR=
# MCP endpoint exported to the harness. Must match this server's /mcp mount.
POLYGLOT_MCP_URL=http://127.0.0.1:8080/mcp
# One complete harness run, in seconds, and the process concurrency cap.
HARNESS_TIMEOUT_SECONDS=120
HARNESS_MAX_CONCURRENT=2
# Dedicated WhatsApp session ID for the admin-only assistant. 0 disables it.
WA_ASSISTANT_SESSION_ID=0
# Loopback URL of `dsh web`; the Go proxy mounts it at /netops/.
HARNESS_WEB_URL=http://127.0.0.1:3080
# Launch token printed by `dsh web`; required for the index cookie exchange.
HARNESS_WEB_TOKEN=
# Optional HMAC key for NetOps sessions and the trusted-proxy header. When
# empty, a key is derived from JWT_SECRET. Use at least 16 characters.
HARNESS_PROXY_SECRET=
# Browser NetOps session lifetime in hours (1-168).
NETOPS_SESSION_HOURS=8

# ─── ISP Scheduler (cron in-process; kosongkan spec untuk menonaktifkan) ─
# Job: billing bulanan, lifecycle (provisi/isolir/suspend), reminder tagihan,
# pengirim WhatsApp, dan snapshot finansial harian.
SCHEDULER_ENABLED=true
BILLING_CRON=0 6 * * *
ISOLATION_CRON=@every 10m
REMINDER_CRON=0 7 * * *
WA_SEND_CRON=@every 30s
SNAPSHOT_CRON=5 0 * * *

# ─── Seeding ──────────────────────────────────────────────────────────
# Required only when running cmd/seed or scripts/seed.go.
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=

# ─── Integration test: Mikrotik (real CHR/device in GNS3) ──────────────
MIKROTIK_TEST_HOST=192.168.230.3
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASS=r00t

# ─── Integration test: GenieACS NBI ────────────────────────────────────
GENIEACS_TEST_URL=
GENIEACS_TEST_DEVICE_ID=
GENIEACS_TEST_API_KEY=

# ─── Testcontainers ───────────────────────────────────────────────────
TESTCONTAINERS_POSTGRES_IMAGE=postgres:16-alpine

