# Polyglot — environment template
#
# Copy to .env and fill in real values. .env and .env.local are gitignored.
# .env.local is for per-developer overrides and is loaded automatically if present.

# ─── Application ───────────────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ─── PostgreSQL (app database + migration target) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops
DATABASE_URL=postgres://postgres:netops@localhost:5432/netops?sslmode=disable

# ─── Redis (Session State & Rate Limiter for WA Bot) ───────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security & Authentication (JWT & Credential Vault) ───────────────
# ENCRYPTION_KEY must be exactly 32 bytes for AES-256-GCM.
# JWT_SECRET must be at least 32 bytes.
ENCRYPTION_KEY=<CHANGEME-32-BYTE-KEY-HERE>
JWT_SECRET=<CHANGEME-32-BYTE-SECRET-HERE>
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_TTL_HOURS=168

# ─── WhatsApp & Web ───────────────────────────────────────────────────
WA_STORE_DIR=./wa_stores
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── ISP Scheduler (cron in-process; kosongkan spec untuk menonaktifkan) ─
# Job: billing bulanan, lifecycle (provisi/isolir/suspend), reminder tagihan,
# pengirim WhatsApp, dan snapshot finansial harian.
SCHEDULER_ENABLED=true
BILLING_CRON=0 6 * * *
ISOLATION_CRON=@every 10m
REMINDER_CRON=0 7 * * *
WA_SEND_CRON=@every 30s
SNAPSHOT_CRON=5 0 * * *

# ─── Seeding ──────────────────────────────────────────────────────────
# Required only when running cmd/seed or scripts/seed.go.
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=

# ─── Integration test: Mikrotik (real CHR/device in GNS3) ──────────────
MIKROTIK_TEST_HOST=192.168.230.3
MIKROTIK_TEST_PORT=8728
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASS=r00t

# ─── Integration test: GenieACS NBI ────────────────────────────────────
GENIEACS_TEST_URL=
GENIEACS_TEST_DEVICE_ID=
GENIEACS_TEST_API_KEY=

# ─── Testcontainers ───────────────────────────────────────────────────
TESTCONTAINERS_POSTGRES_IMAGE=postgres:16-alpine

# ─── AI Router Ops (PLAN-AI-ROUTER-OPS v2) ─────────────────────────────
# AI boleh READ bebas; setiap MUTATION wajib approval manusia + restore point.
AI_ROUTER_OPS_ENABLED=true
AI_V6_MUTATIONS=true
AI_MAX_PROPOSALS_PER_MINUTE=10
AI_MAX_SCRIPT_LINES=50
APPROVAL_TTL_MINUTES=15
APPROVAL_REQUIRE_REASON_ON_REJECT=true

# Restore point (wajib di production bila AI_ROUTER_OPS_ENABLED=true)
RESTORE_POINT_DIR=data/restorepoints
RESTORE_POINT_RETENTION_DAYS=14
RESTORE_POINT_KEEP_LAST=30
RESTORE_POINT_ENCRYPTION_KEY=<CHANGEME-32-BYTE-OR-BASE64-32>
RESTORE_POINT_MAX_BYTES=52428800
RESTORE_POINT_DEDUPE=true

# Backup terjadwal
BACKUP_DAILY_ENABLED=true
BACKUP_DAILY_AT=02:00
BACKUP_WEEKLY_ENABLED=true
BACKUP_WEEKLY_DAY=sun
BACKUP_WEEKLY_AT=03:00

# Watchdog rollback (default OFF sampai teruji di CHR)
WATCHDOG_ENABLED=false
WATCHDOG_ROLLBACK_SECONDS=600

# Active device binding
ACTIVE_DEVICE_TTL_HOURS=24
AI_SINGLE_DEVICE_FALLBACK=false

# Inspect v7
INSPECT_TIMEOUT_SECONDS=5
INSPECT_CACHE_TTL_MINUTES=10
